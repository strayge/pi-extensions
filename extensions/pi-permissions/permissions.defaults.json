{
  "$schema": "./schemas/permissions.schema.json",
  "version": 3,
  "defaultMode": "project",
  "processMode": "compatible",
  "cycleOrder": ["project", "subproject", "yolo"],
  "modes": {
    "project": {
      "label": "Project",
      "color": "accent",
      "filesystem": { "kind": "scoped", "readOnly": [], "readWrite": [".", "/tmp"], "resourceReads": ["pi", "system"] }
    },
    "subproject": {
      "label": "Subproject",
      "color": "accent",
      "filesystem": { "kind": "scoped", "readOnly": [], "readWrite": ["..", "/tmp"], "resourceReads": ["pi", "system"] }
    },
    "yolo": { "label": "YOLO", "color": "error", "filesystem": { "kind": "unrestricted" } }
  },
  "pathRules": [
    { "path": "$AGENT_DIR/auth.json", "scope": "file", "read": "ask", "write": "ask" },
    { "path": "$AGENT_DIR/permissions", "scope": "tree", "write": "ask" }
  ],
  "network": {
    "default": "open",
    "allowedDomains": ["npmjs.org", "*.npmjs.org", "registry.npmjs.org", "registry.yarnpkg.com", "pypi.org", "*.pypi.org", "github.com", "*.github.com", "api.github.com", "raw.githubusercontent.com"],
    "deniedDomains": []
  }
}

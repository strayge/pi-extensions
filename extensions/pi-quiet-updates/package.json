{
  "name": "@strayge/pi-quiet-updates",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strayge/pi-extensions.git",
    "directory": "extensions/pi-quiet-updates"
  },
  "homepage": "https://github.com/strayge/pi-extensions/tree/main/extensions/pi-quiet-updates#readme",
  "bugs": {
    "url": "https://github.com/strayge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Pi extension that collapses the startup update banners into one muted line.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "updates",
    "startup"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && npm test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}

    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",

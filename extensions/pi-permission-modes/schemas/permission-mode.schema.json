{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pi filesystem profiles and independent network policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "defaultMode": { "type": "string", "minLength": 1 },
    "cycleOrder": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "modes": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-zA-Z0-9_-]+$", "not": { "enum": ["__proto__", "constructor", "prototype"] } },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "color": { "enum": ["muted", "mdLink", "accent", "error"] },
          "filesystem": {
            "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "unrestricted" } } },
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "readOnly", "readWrite", "resourceReads"],
                "properties": {
                  "kind": { "const": "scoped" },
                  "readOnly": { "$ref": "#/$defs/paths" },
                  "readWrite": { "$ref": "#/$defs/paths" },
                  "resourceReads": { "type": "array", "uniqueItems": true, "items": { "enum": ["pi", "system"] } }
                }
              }
            ]
          }
        }
      }
    },
    "pathRules": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "scope"],
        "anyOf": [{ "required": ["read"] }, { "required": ["write"] }],
        "properties": { "path": { "type": "string", "minLength": 1 }, "scope": { "enum": ["file", "tree"] }, "read": { "enum": ["ask", "deny"] }, "write": { "enum": ["ask", "deny"] } }
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "properties": { "default": { "enum": ["restricted", "open"] }, "allowedDomains": { "$ref": "#/$defs/domains" }, "deniedDomains": { "$ref": "#/$defs/domains" } }
    }
  },
  "$defs": {
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "domains": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(\\*\\.)?[a-zA-Z0-9](?:[a-zA-Z0-9.-]*[a-zA-Z0-9])?$" } }
  }
}

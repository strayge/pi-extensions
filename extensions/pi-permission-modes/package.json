{
  "name": "pi-permission-modes",
  "version": "2.2.0",
  "description": "Pi extension providing declarative permission modes: OS-level sandboxing, an allow/ask/deny policy engine, and bash AST gating via tree-sitter.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "permissions",
    "sandbox",
    "security",
    "tree-sitter"
  ],
  "files": [
    "src",
    "schemas",
    "patches",
    "permission-mode.defaults.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "postinstall": "patch-package",
    "check": "biome check . && tsc --noEmit && npm test",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.26",
    "patch-package": "8.0.1",
    "tree-sitter-bash": "^0.25.1",
    "web-tree-sitter": "^0.25.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}

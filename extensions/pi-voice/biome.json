{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": [
      "package.json",
      "biome.json",
      "tsconfig.json",
      "src/filler-cleanup.ts",
      "src/corrections.ts",
      "test/corrections.test.ts",
      "test/filler-cleanup.test.ts",
      "test/settings.test.ts"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  }
}

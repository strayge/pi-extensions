{
  "name": "@strayge/pi-voice",
  "version": "0.2.0",
  "description": "Temporary Pi Voice fork with conservative dictation filler cleanup",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strayge/pi-extensions.git",
    "directory": "extensions/pi-voice"
  },
  "homepage": "https://github.com/strayge/pi-extensions/tree/main/extensions/pi-voice#readme",
  "bugs": {
    "url": "https://github.com/strayge/pi-extensions/issues"
  },
  "files": [
    "src",
    "catalog/catalog.json",
    "catalog/recommendations.json",
    "models/silero-vad-v6.2-F32.gguf",
    "models/README.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "transcription",
    "speech-to-text"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test",
    "recommendations:generate": "node scripts/generate-recommendations.mjs",
    "catalog:verify": "node scripts/catalog-metadata.mjs",
    "catalog:update-metadata": "node scripts/catalog-metadata.mjs --write"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "@earendil-works/pi-tui": ">=1.4.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@huggingface/gguf": "^0.4.6",
    "@types/node": "22.20.1",
    "typebox": "^1.3.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1",
    "@huggingface/hub": "2.15.0",
    "opencc-js": "^1.4.1",
    "transcribe-cpp": "0.4.0"
  }
}

{
  "name": "@strayge/pi-subagents",
  "version": "0.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strayge/pi-extensions.git",
    "directory": "extensions/pi-subagents"
  },
  "homepage": "https://github.com/strayge/pi-extensions/tree/main/extensions/pi-subagents#readme",
  "bugs": {
    "url": "https://github.com/strayge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagents",
    "agents",
    "workflows"
  ],
  "description": "A pi extension that brings Claude Code-like sub-agents and workflow orchestration to pi — parallel execution, live widget, fleet view, custom agent types, mid-run steering, dynamic workflows, Claude Code compatibility, look and feel.",
  "type": "module",
  "license": "MIT",
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "npm run lint && npm run typecheck && npm test",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --fix src/ test/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run e2e --reporter=verbose",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest bench",
    "bench:ab": "node test/perf/ab.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.87.1",
    "@earendil-works/pi-coding-agent": ">=0.87.1",
    "@earendil-works/pi-tui": ">=0.87.1",
    "typebox": "*"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.49",
    "croner": "^10.0.1",
    "nanoid": "^5.1.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^25.5.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "typebox": "^1.3.7",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}

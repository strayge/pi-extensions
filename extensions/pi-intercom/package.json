{
  "name": "@strayge/pi-intercom",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/strayge/pi-extensions.git",
    "directory": "extensions/pi-intercom"
  },
  "homepage": "https://github.com/strayge/pi-extensions/tree/main/extensions/pi-intercom#readme",
  "bugs": {
    "url": "https://github.com/strayge/pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Direct messaging and coordination between pi sessions through a local broker.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "intercom"
  ],
  "main": "./src/index.ts",
  "bin": {
    "pi-intercom": "cli.mjs"
  },
  "files": [
    "src",
    "skills",
    "LICENSE",
    "README.md",
    "cli.mjs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "check": "biome check . && tsc --noEmit && npm test",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.2",
    "@earendil-works/pi-coding-agent": ">=1.0.2",
    "@earendil-works/pi-tui": ">=1.0.2",
    "typebox": "*"
  },
  "dependencies": {
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-coding-agent": "1.0.2",
    "@earendil-works/pi-tui": "1.0.2",
    "@types/node": "25.5.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2"
  }
}
